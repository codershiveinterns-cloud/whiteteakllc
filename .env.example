ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-strong-admin-password
ADMIN_SYNTHETIC_EMAIL=admin@yourdomain.local
AUTH_SECRET=generate-a-long-random-string-here
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=rzp_test_secret_xxxx

# Stripe (test)
STRIPE_PUBLIC_KEY=pk_test_xxxx
STRIPE_SECRET_KEY=sk_test_xxxx

# PayPal (sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# SMTP — required to deliver OTPs and transactional mail
# Pick ONE provider below and fill in the matching values, then uncomment.
#
# Gmail / Google Workspace (for support@whiteteakllc.com on Google Workspace):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=support@whiteteakllc.com
#   SMTP_PASS=<16-char app password from https://myaccount.google.com/apppasswords>
#
# Zoho Mail (free for custom domains):
#   SMTP_HOST=smtp.zoho.com
#   SMTP_PORT=587
#   SMTP_USER=support@whiteteakllc.com
#   SMTP_PASS=<your Zoho password or app-specific password>
#
# SendGrid (free tier 100/day, great for deliverability):
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=<your SendGrid API key>
#
# Mailgun, Amazon SES, Brevo (Sendinblue), Resend — all work the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Displayed FROM header. "Name <email>" format is accepted.
SMTP_FROM=WhiteTeak LLC Admin <admin@whiteteakllc.com>
# Where replies land for authentication / account mail.
SMTP_REPLY_TO=admin@whiteteakllc.com

# Firebase Firestore mirror (optional)
# Option A: paste the whole service-account JSON as a single line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}
# Option B: individual vars from the service-account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full private_key string, keep the \n newlines literal
FIREBASE_PRIVATE_KEY=
